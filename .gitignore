# Rust build artifacts
/target
/debug
/release

# SPA build output (regenerated by `npm run build`)
/target/web-dist

# Local data — never commit DuckDB / WAL / redb state
/data
/data-*
data*
*.duckdb
*.duckdb.wal
*.redb

# Local config with secrets — copy central-logs.toml.example and edit locally
/central-logs.toml
/config.local.toml

# Environment files
.env
.env-*
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Node (web/ has its own .gitignore via npm, but be explicit)
/web/node_modules
/web/dist
/web/.vite

# Logs
*.log
