# central-logs environment file.
# Copy to `.env` (gitignored) and fill in. The server loads `.env` at startup;
# variables already present in the real environment take precedence.

# Admin API key (legacy static-key mode → implicit admin scope).
# Pinning it here makes the credential stable across restarts AND data-dir
# resets, and avoids the one-time bootstrap token entirely.
# Generate a value with:  openssl rand -hex 24   (then prefix with clk_)
CENTRAL_LOGS_HTTP_API_KEY=

# App-specific insert keys minted via POST /v1/api-keys (see INTEGRATION.md
# Step 3). CRUD keys live in the DuckDB api_keys table, so a data-dir reset
# invalidates them — re-run the mint step and update the value here.
MY_APP_INSERT_KEY=
